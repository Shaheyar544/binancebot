# ==============================================================================
# XAUUSDT Adaptive Long-Only Bot — Environment Configuration
# ==============================================================================
# SAFETY FIRST:
# Live trading is disabled by default. Both LIVE_TRADING and ENABLE_ORDER_EXECUTION
# must be explicitly set to 'true' to allow actual order submission.
# API keys must NEVER be committed or logged.
# ==============================================================================

# Execution Safety Gates (DO NOT enable without completing full paper/shadow testing)
LIVE_TRADING=false
ENABLE_ORDER_EXECUTION=false

# Binance Futures API Credentials (USDⓈ-M / TradFi Perpetuals)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Database Persistence
DATABASE_PATH=xau_bot.db

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# User Risk Configuration Defaults (Mandatory Settings)
# ALLOCATED_FUNDS: Capital assigned to bot in USD/USDT
USER_ALLOCATED_FUNDS=1000.00
# LEVERAGE: Fixed leverage multiplier (e.g. 5 for 5x)
USER_LEVERAGE=5.0
# MAX_ACCEPTABLE_LIQUIDATION_PRICE: Inviolable floor price below which liquidation must never occur
USER_MAX_ACCEPTABLE_LIQUIDATION_PRICE=2000.00

# Optional Risk Parameters
USER_MAX_ENTRIES=3
USER_MAX_DAILY_LOSS=100.00
USER_RISK_PER_TRADE_PCT=1.5
USER_EMERGENCY_LOSS_LIMIT=200.00
USER_MAX_TOTAL_EXPOSURE=1500.00
USER_MIN_ENTRY_SCORE=85
